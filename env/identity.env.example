# Secretos de mubEZ (broker M8) para producción. Copia a env/identity.env.
# Genera cada secreto con:  openssl rand -base64 48
# Nunca reutilices JWT_SECRET en otro servicio: rotarlo invalida sesiones.

JWT_SECRET=
APP_KEY=
COOKIE_SECRET=
CURP_PEPPER=
CURP_PEPPER_KEY_ID=v1

# Orígenes que pueden llamar al broker desde el navegador (coma separados).
CORS_ORIGIN=https://example.org

# Login explícito de PARA (nativo y web). Sustituye example.org por el origen
# real de la app web; conserva el callback de iM8 si ese cliente sigue activo.
# Estos overrides fijan ambos flags incluso cuando se conecta GrowthBook.
GROWTHBOOK_FEATURE_OVERRIDES={"m8:auth:oauth_mobile_handoff":true,"m8:auth:dev_token_bootstrap":false}
OAUTH_RETURN_TO_ALLOWLIST=im8://oauth/callback,para://m8-auth,https://example.org/m8-auth

# Llave del emisor de credenciales de identidad (JWK). Ver mubEZ/README.md.
IDENTITY_ISSUER_DID=
IDENTITY_ISSUER_KEY_ID=
IDENTITY_ISSUER_PRIVATE_JWK=
IDENTITY_ISSUER_PUBLIC_JWK=

LOG_LEVEL=info
