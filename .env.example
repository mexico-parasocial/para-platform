# Copia a .env y ajusta. Este archivo NO debe llevar secretos de mubEZ
# (esos van en env/identity.env).

# Dominio público. El edge publica pds., appview., ozone., bridge. y m8.
PARA_DOMAIN=example.org

# Dónde están los otros repos (por defecto, carpetas hermanas de esta).
WATZAPPA_DIR=../WatZappa
MUBEZ_DIR=../mubEZ
PARA_DIR=../PARA
IM8_DIR=../../iM8

# PLC que usan mubEZ y el resto en producción.
PLC_URL=https://plc.directory

# Perfiles que levanta `make up` si no pasas PROFILES=...
PROFILES=core,matrix,identity,edge
