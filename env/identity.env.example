# Secretos de mubEZ (broker M8) para producción. Copia a env/identity.env.
# Genera cada secreto con:  openssl rand -base64 48
# Nunca reutilices JWT_SECRET en otro servicio: rotarlo invalida sesiones.

JWT_SECRET=
APP_KEY=
COOKIE_SECRET=
CURP_PEPPER=
CURP_PEPPER_KEY_ID=v1

# Orígenes que pueden llamar al broker desde el navegador (coma separados).
CORS_ORIGIN=https://example.org

# Llave del emisor de credenciales de identidad (JWK). Ver mubEZ/README.md.
IDENTITY_ISSUER_DID=
IDENTITY_ISSUER_KEY_ID=
IDENTITY_ISSUER_PRIVATE_JWK=
IDENTITY_ISSUER_PUBLIC_JWK=

LOG_LEVEL=info
